<?php

/**
 * @file
 * Hooks for the Material Inventory Totals module.
 */

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\material_inventory_totals\Service\InventoryTotalsCalculator;
use Drupal\node\NodeInterface;

/**
 * Adjustment reason codes that indicate a human physically checked stock.
 *
 * Automated or payment-driven reasons (sale, unpaid_tab, restock) and usage
 * logs (internal, education, workshop_supplies, program_supplies, shop_use,
 * office_use) are deliberately excluded so they do not masquerade as physical
 * inventory counts.
 */
const MATERIAL_INVENTORY_TOTALS_PHYSICAL_COUNT_REASONS = [
  'other',
  'verification',
  'lossage',
  'restock_unlogged',
  'count_found',
];

/**
 * Implements hook_cron().
 */
function material_inventory_totals_cron(): void {
  /** @var \Drupal\material_inventory_totals\Service\InventoryTotalsCalculator $calculator */
  $calculator = \Drupal::service('material_inventory_totals.calculator');

  // Recalculate a small batch of materials on each cron run to detect drift.
  $calculator->runConsistencyCheck(20);
}

/**
 * Implements hook_entity_insert().
 */
function material_inventory_totals_entity_insert(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'material') {
    material_inventory_totals_refresh_material_value($entity);
  }

  if (!material_inventory_totals_supports_entity($entity)) {
    return;
  }

  $content_entity = $entity instanceof ContentEntityInterface ? $entity : NULL;
  if (!$content_entity) {
    return;
  }

  $material_id = material_inventory_totals_extract_material_id($content_entity);
  $quantity = material_inventory_totals_extract_quantity($content_entity);

  if ($material_id !== NULL && $quantity !== 0) {
    material_inventory_totals_calculator()->applyDelta($material_id, $quantity);
  }

  // Stamp the material's last-inventoried date when the adjustment reason
  // indicates a human physically checked stock. Runs after applyDelta() so
  // the freshly persisted totals are not overwritten.
  if ($material_id !== NULL && material_inventory_totals_is_physical_count($content_entity)) {
    material_inventory_totals_stamp_last_inventoried($material_id);
  }
}

/**
 * Implements hook_entity_update().
 */
function material_inventory_totals_entity_update(EntityInterface $entity): void {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'material') {
    material_inventory_totals_refresh_material_value($entity);
  }

  if (!material_inventory_totals_supports_entity($entity)) {
    return;
  }

  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  $material_id = material_inventory_totals_extract_material_id($entity);
  $quantity = material_inventory_totals_extract_quantity($entity);

  $original = $entity->original ?? NULL;
  if (!$original instanceof ContentEntityInterface || !material_inventory_totals_supports_entity($original)) {
    if ($material_id !== NULL) {
      material_inventory_totals_calculator()->recalculate($material_id);
    }
    return;
  }

  $original_material_id = material_inventory_totals_extract_material_id($original);
  $original_quantity = material_inventory_totals_extract_quantity($original);

  if ($material_id !== NULL && $original_material_id !== NULL) {
    if ($material_id === $original_material_id) {
      $delta = $quantity - $original_quantity;
      if ($delta !== 0) {
        material_inventory_totals_calculator()->applyDelta($material_id, $delta);
      }
    }
    else {
      material_inventory_totals_calculator()->applyDelta($original_material_id, -$original_quantity);
      material_inventory_totals_calculator()->applyDelta($material_id, $quantity);
    }
  }
  elseif ($material_id !== NULL) {
    material_inventory_totals_calculator()->recalculate($material_id);
  }
  elseif ($original_material_id !== NULL) {
    material_inventory_totals_calculator()->recalculate($original_material_id);
  }
}

/**
 * Implements hook_entity_delete().
 */
function material_inventory_totals_entity_delete(EntityInterface $entity): void {
  if (!material_inventory_totals_supports_entity($entity)) {
    return;
  }

  if (!$entity instanceof ContentEntityInterface) {
    return;
  }

  $material_id = material_inventory_totals_extract_material_id($entity);
  $quantity = material_inventory_totals_extract_quantity($entity);

  if ($material_id !== NULL && $quantity !== 0) {
    material_inventory_totals_calculator()->applyDelta($material_id, -$quantity);
  }
}

/**
 * Checks if the entity is an inventory adjustment we care about.
 */
function material_inventory_totals_supports_entity(EntityInterface $entity): bool {
  return $entity instanceof ContentEntityInterface
    && $entity->getEntityTypeId() === 'material_inventory'
    && $entity->bundle() === 'inventory_adjustment';
}

/**
 * Extracts the referenced material node ID.
 */
function material_inventory_totals_extract_material_id(ContentEntityInterface $entity): ?int {
  if (!$entity->hasField('field_inventory_ref_material')) {
    return NULL;
  }

  $target = $entity->get('field_inventory_ref_material')->target_id;
  return $target !== NULL ? (int) $target : NULL;
}

/**
 * Extracts the quantity change from the entity.
 */
function material_inventory_totals_extract_quantity(ContentEntityInterface $entity): int {
  if (!$entity->hasField('field_inventory_quantity_change')) {
    return 0;
  }

  return (int) $entity->get('field_inventory_quantity_change')->value;
}

/**
 * Determines whether an adjustment represents a physical stock check.
 */
function material_inventory_totals_is_physical_count(ContentEntityInterface $adjustment): bool {
  if (!$adjustment->hasField('field_inventory_change_reason')) {
    return FALSE;
  }

  $reason = $adjustment->get('field_inventory_change_reason')->value;
  return in_array($reason, MATERIAL_INVENTORY_TOTALS_PHYSICAL_COUNT_REASONS, TRUE);
}

/**
 * Stamps field_material_last_inventoried on a material node with "now".
 *
 * Saving the material re-enters material_inventory_totals_entity_update(),
 * but that path only recalculates cached totals (which will not have changed)
 * and never creates adjustment entities, so no recursion occurs.
 */
function material_inventory_totals_stamp_last_inventoried(int $material_id): void {
  $material = \Drupal::entityTypeManager()->getStorage('node')->load($material_id);
  if (!$material instanceof NodeInterface || $material->bundle() !== 'material') {
    return;
  }

  if (!$material->hasField('field_material_last_inventoried')) {
    return;
  }

  $material->set('field_material_last_inventoried', \Drupal::time()->getCurrentTime());
  $material->save();
}

/**
 * Helper to fetch the calculator service.
 */
function material_inventory_totals_calculator(): InventoryTotalsCalculator {
  return \Drupal::service('material_inventory_totals.calculator');
}

/**
 * Recalculate cached totals when a material node is updated.
 */
function material_inventory_totals_refresh_material_value(NodeInterface $material): void {
  material_inventory_totals_calculator()->recalculate((int) $material->id());
}

/**
 * Implements hook_form_FORM_ID_alter() for the inventory adjustment add form.
 *
 * A restock is when stock that did not fit on the shelf goes to backstock, so
 * the restock form carries the material's backstock location. People who may
 * edit field_material_backstock can change it here; others see it read-only,
 * as on the count form.
 */
function material_inventory_totals_form_material_inventory_inventory_adjustment_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface || !$form_object->getEntity()->isNew()) {
    return;
  }

  // Store tab lines are written by the store, never by hand. The value has a
  // label so existing lines read properly, but it is not a manual choice.
  unset($form['field_inventory_change_reason']['widget']['#options']['unpaid_tab']);

  $material_id = material_inventory_totals_extract_material_id($form_object->getEntity())
    ?? (int) \Drupal::request()->query->get('material');
  $material = $material_id ? \Drupal::entityTypeManager()->getStorage('node')->load($material_id) : NULL;
  if (!$material instanceof NodeInterface || $material->bundle() !== 'material' || !$material->hasField('field_material_backstock')) {
    return;
  }

  $backstock = $material->get('field_material_backstock');
  $current = (string) ($backstock->value ?? '');
  $restock_only = [
    'visible' => [
      ':input[name="field_inventory_change_reason"]' => ['value' => 'restock'],
    ],
  ];

  if ($backstock->access('edit')) {
    $form['material_backstock'] = [
      '#type' => 'textfield',
      '#title' => t('Backstock location'),
      '#description' => t('Where the extra stock for @material is kept. Update it if you put stock somewhere new.', ['@material' => $material->label()]),
      '#default_value' => $current,
      '#maxlength' => 255,
      '#weight' => 3,
      '#states' => $restock_only,
    ];
    $form['material_backstock_nid'] = [
      '#type' => 'value',
      '#value' => (int) $material->id(),
    ];
    $form['actions']['submit']['#submit'][] = 'material_inventory_totals_save_backstock_location';
  }
  elseif ($current !== '' && $backstock->access('view')) {
    $form['material_backstock'] = [
      '#type' => 'item',
      '#title' => t('Backstock location'),
      '#markup' => Html::escape($current),
      '#weight' => 3,
      '#states' => $restock_only,
    ];
  }
}

/**
 * Submit handler: writes the restock form's backstock location to the material.
 */
function material_inventory_totals_save_backstock_location(array &$form, FormStateInterface $form_state): void {
  if ($form_state->getValue(['field_inventory_change_reason', 0, 'value']) !== 'restock') {
    return;
  }
  $adjustment = $form_state->getFormObject()->getEntity();
  $material_id = (int) $form_state->getValue('material_backstock_nid');
  // The field was filled from one material; do not copy it onto another one
  // if the person switched the material before saving.
  if (material_inventory_totals_extract_material_id($adjustment) !== $material_id) {
    return;
  }
  $material = \Drupal::entityTypeManager()->getStorage('node')->load($material_id);
  if (!$material instanceof NodeInterface || !$material->get('field_material_backstock')->access('edit')) {
    return;
  }

  $location = trim((string) $form_state->getValue('material_backstock'));
  if ($location === (string) ($material->get('field_material_backstock')->value ?? '')) {
    return;
  }
  $material->set('field_material_backstock', $location === '' ? NULL : $location);
  $material->setNewRevision(TRUE);
  $material->setRevisionLogMessage('Backstock location updated from the restock form.');
  $material->save();
  \Drupal::messenger()->addStatus(t('Backstock location for @material updated.', ['@material' => $material->label()]));
}

/**
 * Adds field_material_last_inventoried timestamp field to material nodes.
 */
function material_inventory_totals_update_9001(): void {
  $field_storage_config = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config');
  $field_config = \Drupal::entityTypeManager()
    ->getStorage('field_config');

  if (!$field_storage_config->load('node.field_material_last_inventoried')) {
    $field_storage_config->create([
      'field_name' => 'field_material_last_inventoried',
      'entity_type' => 'node',
      'type' => 'timestamp',
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  if (!$field_config->load('node.material.field_material_last_inventoried')) {
    $field_config->create([
      'field_name' => 'field_material_last_inventoried',
      'entity_type' => 'node',
      'bundle' => 'material',
      'label' => 'Last Inventoried',
      'description' => 'Timestamp of the most recent physical inventory count for this item.',
      'required' => FALSE,
    ])->save();
  }
}
